{
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",              // Python
                "ms-python.python-environments", // Python Environments
                "ms-python.debugpy",             // Python Debugger
                "ms-python.pylint",              // Pylint
                "ms-python.vscode-pylance",      // Pylance
                "ms-vscode.anycode",             // Anycode
                "davidanson.vscode-markdownlint", // Markdown
                "ParisNeo.toml-hilighter", // TOML
                "fanaticpythoner.better-todo-tree",
                "mads-hartmann.bash-ide-vscode",
                "aaron-bond.better-comments",
                "tamasfe.even-better-toml",
                "github.vscode-github-actions",
                "omartawfik.github-actions-vscode",
                "marcovr.actions-shell-scripts",
                "oderwat.indent-rainbow",
                "davidanson.vscode-markdownlint",
                "pkief.material-icon-theme",
                "mintlify.document",
                "alefragnani.project-manager",
                "redhat.vscode-yaml"
            ]
        },
        "codespaces": {
            "repositories": {
                "Boss-1s/key_multivalue_storage": {
                    "permissions": "write"
                },
                "Boss-1s/scratchattach": {
                    "permissions": "write"
                }
            }
        }
    },
    // Use 'postCreateCommand' to run commands after the container is created.
    "postCreateCommand": "pip install --upgrade pip && pip install uv && git remote set-url origin https://Boss-1s:$(gh auth token)@github.com && pip install -r requirements.txt && pip install -e ."
}
